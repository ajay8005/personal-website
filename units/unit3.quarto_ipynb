    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "x = np.random.normal(size=100)\n",
        "import matplotlib.pyplot as plt\n",
        "plt.hist(x)\n",
        "plt.show()\n",
        "np.mean(x)"
      ],
      "id": "a084ed0c",
      "execution_count": null,
      "outputs": []
